MODE="production"

# --- Self-hosted storage backend (scene share links) ---
# nginx vhost 将 /api/v2/ 反代到 excalidraw-storage:8080
VITE_APP_BACKEND_V2_GET_URL=https://excalidraw.galanhao.xyz/api/v2/
VITE_APP_BACKEND_V2_POST_URL=https://excalidraw.galanhao.xyz/api/v2/post/

# --- Libraries (official public library, kept) ---
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

# --- Plus (keep official entry points; login is not self-hostable) ---
VITE_APP_PLUS_LP=https://plus.excalidraw.com
VITE_APP_PLUS_APP=https://app.excalidraw.com

# --- AI backend: self-hosted AI gateway (nginx /v1/ 反代到 ai-gateway) ---
VITE_APP_AI_BACKEND=https://excalidraw.galanhao.xyz

# --- socket server URL used for collaboration ---
# nginx vhost 将 /socket.io/ 反代到 excalidraw-room:80
VITE_APP_WS_SERVER_URL=https://excalidraw.galanhao.xyz

# --- Firebase: disabled in self-hosted build ---
VITE_APP_FIREBASE_CONFIG='{}'

VITE_APP_ENABLE_TRACKING=false

